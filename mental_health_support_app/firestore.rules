rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function patientDocPath(uid) {
      return /databases/$(database)/documents/patients/$(uid);
    }

    function guardianDocPath(uid) {
      return /databases/$(database)/documents/guardians/$(uid);
    }

    function hasRole(role) {
      return signedIn() &&
        exists(userDocPath(request.auth.uid)) &&
        get(userDocPath(request.auth.uid)).data.role == role;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isPatient() {
      return hasRole('patient');
    }

    function isGuardian() {
      return hasRole('guardian');
    }

    function isCounselor() {
      return hasRole('counselor');
    }

    function patientExists(patientUid) {
      return exists(patientDocPath(patientUid));
    }

    function guardianExists(guardianUid) {
      return exists(guardianDocPath(guardianUid));
    }

    function isAssignedDoctor(patientUid) {
      return isDoctor() &&
        patientExists(patientUid) &&
        get(patientDocPath(patientUid)).data.assignedDoctor == request.auth.uid;
    }

    function isLinkedGuardian(patientUid) {
      return isGuardian() &&
        guardianExists(request.auth.uid) &&
        get(guardianDocPath(request.auth.uid)).data.patientUid == patientUid;
    }

    function canReadPatientScoped(patientUid) {
      return isSelf(patientUid) ||
        isAssignedDoctor(patientUid) ||
        isLinkedGuardian(patientUid);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow update: if isSelf(uid);
      allow create, delete: if false;
    }

    match /patients/{patientUid} {
      allow read: if isSelf(patientUid) ||
        resource.data.assignedDoctor == request.auth.uid ||
        isLinkedGuardian(patientUid) ||
        isCounselor();
      allow create, update, delete: if false;
    }

    match /guardians/{guardianUid} {
      allow read: if isSelf(guardianUid) ||
        (
          isDoctor() &&
          guardianExists(guardianUid) &&
          isAssignedDoctor(get(guardianDocPath(guardianUid)).data.patientUid)
        ) ||
        isCounselor();
      allow create, update, delete: if false;
    }

    match /daily_logs/{logId} {
      allow read: if canReadPatientScoped(resource.data.patientUid);
      allow create: if isPatient() && request.resource.data.patientUid == request.auth.uid;
      allow update, delete: if isPatient() && resource.data.patientUid == request.auth.uid;
    }

    match /diary_entries/{entryId} {
      allow read: if canReadPatientScoped(resource.data.patientUid);
      allow create: if isPatient() && request.resource.data.patientUid == request.auth.uid;
      allow update, delete: if isPatient() && resource.data.patientUid == request.auth.uid;
    }

    match /guardian_logs/{logId} {
      allow read: if canReadPatientScoped(resource.data.patientUid);
      allow create: if isGuardian() &&
        request.resource.data.guardianUid == request.auth.uid &&
        isLinkedGuardian(request.resource.data.patientUid);
      allow update, delete: if isGuardian() &&
        resource.data.guardianUid == request.auth.uid &&
        isLinkedGuardian(resource.data.patientUid);
    }

    match /prescriptions/{prescriptionId} {
      allow read: if canReadPatientScoped(resource.data.patientUid) ||
        (isDoctor() && resource.data.doctorUid == request.auth.uid);
      allow create, update: if isDoctor() &&
        request.resource.data.doctorUid == request.auth.uid;
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if canReadPatientScoped(resource.data.patientUid) ||
        (isDoctor() && resource.data.doctorUid == request.auth.uid);
      allow create, update: if isDoctor() &&
        request.resource.data.doctorUid == request.auth.uid;
      allow delete: if false;
    }

    match /reschedule_requests/{requestId} {
      allow read: if (isPatient() && resource.data.patientUid == request.auth.uid) ||
        (isDoctor() && resource.data.doctorUid == request.auth.uid);
      allow create: if isPatient() &&
        request.resource.data.patientUid == request.auth.uid;
      allow update: if isDoctor() && resource.data.doctorUid == request.auth.uid;
      allow delete: if false;
    }

    match /analytics_snapshots/{snapshotId} {
      allow read: if canReadPatientScoped(resource.data.patientUid);
      allow create, update, delete: if false;
    }

    match /medicines/{medicineId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /chat_sessions/{sessionId} {
      allow read: if
        (isPatient() && resource.data.patientUid == request.auth.uid) ||
        (isCounselor() && (
          resource.data.counselorUid == request.auth.uid ||
          resource.data.status == 'waiting'
        ));
      allow create: if isPatient() &&
        request.resource.data.patientUid == request.auth.uid;
      allow update: if
        (isCounselor() && (
          resource.data.counselorUid == request.auth.uid ||
          resource.data.status == 'waiting'
        )) ||
        (isPatient() && resource.data.patientUid == request.auth.uid);
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if
          (isPatient() &&
            get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.patientUid == request.auth.uid) ||
          (isCounselor() &&
            get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.counselorUid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /doctors/{doctorUid} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /counselors/{counselorUid} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /clinical_alerts/{alertId} {
      allow read: if isDoctor() || isCounselor();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
